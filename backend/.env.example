# Copy to backend/.env (gitignored) and fill in. Never commit real values.
# PostgreSQL (role and databases created with psql; password set with \password)
DATABASE_URL=postgresql+psycopg://railopt:CHANGE_ME@localhost:5432/railopt
# Optional: a THROWAWAY database for `python -m pytest -m postgres` (its name must contain "test")
# TEST_DATABASE_URL=postgresql+psycopg://railopt:CHANGE_ME@localhost:5432/railopt_test
# Long random secret for the session cookies, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
# true when the app is served over HTTPS (cookies get the Secure flag)
COOKIE_SECURE=false
ACCESS_TOKEN_MIN=15
REFRESH_TOKEN_HOURS=8
# Optional first admin, created at API start only when no admin exists; remove the password after
# RAILOPT_ADMIN_EMAIL=
# RAILOPT_ADMIN_PASSWORD=
# Start-up scenario on an empty database: replay (REAL demo day, default) or simulated
# RAILOPT_BOOT=replay
